#!/bin/bash
#SBATCH --job-name=quantum_vqe
#SBATCH --partition=gpu
#SBATCH --array=1-50%10
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=128G
#SBATCH --time=06:00:00
#SBATCH --output=logs/vqe_%A_%a.out
#SBATCH --error=logs/vqe_%A_%a.err

# ============================================================
# GPU-accelerated state-vector simulation of a Variational
# Quantum Eigensolver (VQE) for molecular ground-state energy
# estimation. Array job sweeps over molecular geometries
# (e.g. a bond-dissociation curve) with classical optimization
# of circuit parameters on each GPU.
# ============================================================

set -euo pipefail
mkdir -p logs results

module purge
module load cuda/12.2
module load anaconda3/2024.02
source activate qiskit_gpu_env

GEOMETRY_TABLE="bond_geometries.tsv"    # columns: id  bond_length_angstrom
TASK_ID="$SLURM_ARRAY_TASK_ID"

# ---- Generate bond-length sweep table ----
if [ "$TASK_ID" -eq 1 ] && [ ! -f "$GEOMETRY_TABLE" ]; then
    python3 - <<'EOF'
rows = []
for i in range(1, 51):
    bond_length = 0.5 + (i - 1) * (3.0 - 0.5) / 49
    rows.append(f"{i}\t{bond_length:.4f}")
with open("bond_geometries.tsv", "w") as f:
    f.write("id\tbond_length_angstrom\n")
    f.write("\n".join(rows) + "\n")
EOF
fi

for i in {1..15}; do
    [ -f "$GEOMETRY_TABLE" ] && break
    sleep 2
done

LINE=$((TASK_ID + 1))
read -r ID BOND_LENGTH <<< "$(sed -n "${LINE}p" "$GEOMETRY_TABLE")"
echo "=== VQE task $ID: bond length = ${BOND_LENGTH} Angstrom ==="

# ---- Run VQE with GPU state-vector simulator backend ----
python3 vqe_molecule.py \
    --molecule H2O \
    --bond-length "$BOND_LENGTH" \
    --basis sto-3g \
    --ansatz UCCSD \
    --optimizer COBYLA \
    --max-iterations 500 \
    --backend aer_simulator_statevector_gpu \
    --shots 0 \
    --seed "$TASK_ID" \
    --output "results/vqe_result_${ID}.json"

# ---- Extract converged ground-state energy ----
python3 -c "
import json
with open('results/vqe_result_${ID}.json') as f:
    r = json.load(f)
print(f'Bond length ${BOND_LENGTH}: E = {r[\"optimal_energy\"]:.6f} Hartree, converged={r[\"converged\"]}')
"

echo "Task $ID done at $(date)"
# After all tasks complete, plot the potential energy surface with:
#   python3 plot_pes_curve.py --results-dir results --output h2o_dissociation_curve.png