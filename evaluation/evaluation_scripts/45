#!/bin/bash
#SBATCH --job-name=blast_alignment
#SBATCH --partition=compute
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --time=24:00:00

module load blast+/2.14.0

blastp -query bacterial_proteomes.faa     -db nr_bacteria     -out blast_results.xml     -evalue 1e-10     -num_threads 16     -outfmt 5
