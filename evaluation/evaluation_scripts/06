#!/bin/bash
#SBATCH --job-name=bert_ner
#SBATCH --partition=gpu
#SBATCH --cpus-per-task=16
#SBATCH --gres=gpu:a100:4
#SBATCH --mem=256G
#SBATCH --time=36:00:00

cd $SLURM_SUBMIT_DIR

singularity exec --nv tensorflow-2.12.sif     python finetune_bert_ner.py     --model-name=bert-base-uncased     --fp16     --batch-size=32     --epochs=5     --data-dir=/workspace/ner_data
