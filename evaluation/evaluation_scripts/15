cd $SLURM_SUBMIT_DIR

apptainer exec --nv deepspeed.sif     deepspeed train_gpt3_deepspeed.py     --deepspeed_config ds_config.json     --zero-stage=3     --gradient-accumulation-steps=8     --batch-size-per-gpu=4
