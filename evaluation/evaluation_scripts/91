#!/bin/bash
#SBATCH --job-name=phasefield_solidify
#SBATCH --partition=gpu
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=4
#SBATCH --gres=gpu:4
#SBATCH --cpus-per-task=8
#SBATCH --time=18:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# ============================================================
# Phase-field simulation of dendritic solidification during
# alloy casting (microstructure evolution). Solves coupled
# phase-field + solute-diffusion + thermal equations on a
# GPU-accelerated finite-difference grid. Sweeps undercooling
# conditions as an array-like parameter set via a manifest.
# ============================================================

set -euo pipefail
mkdir -p logs microstructure

module purge
module load cuda/12.2
module load openmpi/4.1.5
module load petsc/3.20.0-gpu
module load amrex/24.06

CASE_DIR="/projects/myuser/phasefield/al_cu_dendrite"
cd "$CASE_DIR"

TOTAL_GPUS=$((SLURM_NNODES * 4))
echo "=== Phase-field solidification: $TOTAL_GPUS GPUs ==="

UNDERCOOLING_K=20.0
INIT_COMPOSITION=0.04    # Cu mole fraction

# ---- Restart detection ----
LATEST_STATE=$(ls -v microstructure/state_t*.h5 2>/dev/null | tail -n1 || true)
if [ -n "$LATEST_STATE" ]; then
    echo "Resuming from: $LATEST_STATE"
    RESTART_FLAG="--restart ${LATEST_STATE}"
else
    echo "Starting fresh with planar seed nucleus"
    RESTART_FLAG="--seed-nucleus planar --undercooling ${UNDERCOOLING_K} --composition ${INIT_COMPOSITION}"
fi

# ---- Run phase-field solver (multi-GPU domain decomposition) ----
srun --mpi=pmix --gpus-per-task=1 \
    ./phasefield_solver \
    --grid 2048 2048 \
    --dx 0.5e-6 \
    --dt-adaptive \
    --model kim_kim_suzuki \
    --alloy Al-Cu \
    $RESTART_FLAG \
    --run-time-seconds 5.0 \
    --output-dir microstructure \
    --checkpoint-every 500

# ---- Verify completion and compute dendrite tip velocity / secondary arm spacing ----
LATEST_STATE=$(ls -v microstructure/state_t*.h5 | tail -n1)
module load python/3.11
python3 analyze_dendrite_morphology.py \
    --state-file "$LATEST_STATE" \
    --output microstructure/morphology_metrics.json

TIP_VELOCITY=$(python3 -c "
import json
with open('microstructure/morphology_metrics.json') as f:
    print(json.load(f).get('tip_velocity_um_s', 'unknown'))
")
echo "Dendrite tip velocity: ${TIP_VELOCITY} um/s"

# ---- Chain if solidification isn't complete (liquid fraction > threshold) ----
LIQUID_FRACTION=$(python3 -c "
import json
with open('microstructure/morphology_metrics.json') as f:
    print(json.load(f).get('liquid_fraction', 1.0))
")

if awk -v l="$LIQUID_FRACTION" 'BEGIN{exit !(l > 0.05)}'; then
    echo "Liquid fraction still ${LIQUID_FRACTION} - resubmitting continuation"
    sbatch "$0"
else
    echo "Solidification essentially complete (liquid fraction < 5%)."
fi

echo "=== Job finished: $(date) ==="