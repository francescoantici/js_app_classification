#!/bin/bash
#SBATCH --job-name=nr_bbh_merger
#SBATCH --partition=compute
#SBATCH --nodes=32
#SBATCH --ntasks-per-node=32
#SBATCH --time=48:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
#SBATCH --signal=B:USR1@600

# ============================================================
# Numerical relativity simulation of a binary black hole
# merger using the Einstein Toolkit (Cactus/Carpet AMR
# framework), solving the BSSN/CCZ4 formulation of Einstein's
# equations. Chains inspiral -> merger -> ringdown segments via
# Carpet checkpoint/restart, extracting gravitational
# waveforms (psi4) at each segment.
# ============================================================

set -euo pipefail
mkdir -p logs

module purge
module load gcc/12.2.0
module load openmpi/4.1.5
module load hdf5/1.14.0-mpi
module load petsc/3.20.0
module load gsl/2.7.1

CASE_DIR="/projects/myuser/numrel/bbh_q4_spin_aligned"
cd "$CASE_DIR"

echo "=== NR BBH merger segment: $(date) ==="

checkpoint_handler() {
    echo "[SIGNAL] Wall-time warning - Carpet will checkpoint at next iteration"
    touch TERMINATE_REQUESTED
}
trap checkpoint_handler USR1

# ---- Restart detection (Carpet checkpoint files) ----
LATEST_CKPT=$(ls -d checkpoints/checkpoint.chkpt.it_* 2>/dev/null | sort -t_ -k2 -n | tail -n1 || true)

if [ -n "$LATEST_CKPT" ]; then
    echo "Restarting from: $LATEST_CKPT"
    PARFILE="bbh_restart.par"
    sed "s#@RECOVER_FILE@#${LATEST_CKPT}#" bbh_template.par > "$PARFILE"
else
    echo "Starting fresh from puncture initial data (TwoPunctures)"
    PARFILE="bbh_initial.par"
fi

# ---- Run Cactus/Carpet ----
srun --mpi=pmix ./cactus_sim "$PARFILE"

rm -f TERMINATE_REQUESTED

# ---- Check merger status via horizon finder (AHFinderDirect) output ----
COMMON_HORIZON=$(grep -c "common horizon found" output/BH_diagnostics.log 2>/dev/null || echo 0)

if [ "$COMMON_HORIZON" -ge 1 ]; then
    echo "Common apparent horizon detected - merger has occurred."
    echo "Continuing briefly for ringdown, then extracting final waveform."
fi

# ---- Check whether simulation reached its target final time ----
if grep -q "Simulation finished" output/cctk_output.log 2>/dev/null; then
    echo "Simulation complete. Extracting gravitational waveform (psi4 -> h)."
    module load python/3.11
    python3 extract_waveform.py \
        --psi4-dir output/psi4_extraction \
        --output analysis/strain_waveform.h5
else
    echo "Simulation not yet complete - resubmitting next segment"
    sbatch "$0"
fi

echo "=== Segment finished: $(date) ==="