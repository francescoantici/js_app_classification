#!/bin/bash
#SBATCH --job-name=adjoint_shape_opt
#SBATCH --partition=compute
#SBATCH --nodes=6
#SBATCH --ntasks-per-node=32
#SBATCH --time=36:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# ============================================================
# Adjoint-based aerodynamic shape optimization (e.g. wing/
# airfoil drag minimization at fixed lift) using SU2's
# discrete-adjoint solver: flow solve -> adjoint solve ->
# surface sensitivity -> mesh deformation -> repeat, until
# the gradient norm falls below tolerance or max iterations.
# ============================================================

set -euo pipefail
mkdir -p logs design_iterations

module purge
module load openmpi/4.1.5
module load su2/8.0.1
module load python/3.11

CASE_DIR="/projects/myuser/aero_opt/wing_drag_minimization"
cd "$CASE_DIR"

MAX_DESIGN_ITERS=30
GRAD_TOL=1e-4

echo "=== Adjoint shape optimization: $(date) ==="

# ---- Determine current design iteration ----
CURRENT_ITER=$(ls -d design_iterations/design_* 2>/dev/null | wc -l)
echo "Starting from design iteration: $CURRENT_ITER"

for ((ITER=CURRENT_ITER; ITER<MAX_DESIGN_ITERS; ITER++)); do
    ITER_DIR="design_iterations/design_${ITER}"
    mkdir -p "$ITER_DIR"
    cd "$ITER_DIR"

    echo "--- Design iteration $ITER ---"

    # ---- Link current mesh/geometry (from previous iteration's deformation) ----
    if [ "$ITER" -eq 0 ]; then
        ln -sf ../../baseline_mesh.su2 mesh.su2
    else
        ln -sf "../design_$((ITER - 1))/deformed_mesh.su2" mesh.su2
    fi
    cp ../../config_flow.cfg .
    cp ../../config_adjoint.cfg .

    # ---- 1. Primal flow solve ----
    srun --mpi=pmix SU2_CFD config_flow.cfg > flow.log 2>&1
    DRAG=$(grep "Total CD" flow.log | tail -n1 | awk '{print $NF}')
    LIFT=$(grep "Total CL" flow.log | tail -n1 | awk '{print $NF}')
    echo "  CD=$DRAG  CL=$LIFT"

    # ---- 2. Adjoint solve (drag-minimization objective) ----
    srun --mpi=pmix SU2_CFD_AD config_adjoint.cfg > adjoint.log 2>&1

    # ---- 3. Compute surface sensitivities ----
    srun --mpi=pmix SU2_DOT_AD config_adjoint.cfg > gradient.log 2>&1

    GRAD_NORM=$(grep "Gradient norm" gradient.log | tail -n1 | awk '{print $NF}')
    echo "  Gradient norm: $GRAD_NORM"

    # ---- 4. Check convergence ----
    if awk -v g="$GRAD_NORM" -v t="$GRAD_TOL" 'BEGIN{exit !(g < t)}'; then
        echo "Optimization converged at iteration $ITER (gradient norm $GRAD_NORM < $GRAD_TOL)"
        cd ../..
        break
    fi

    # ---- 5. Deform mesh along negative gradient direction ----
    python3 ../../compute_shape_update.py \
        --gradient-file surface_sensitivity.dat \
        --step-size 0.01 \
        --output design_update.dat
    srun --mpi=pmix SU2_DEF config_flow.cfg > deform.log 2>&1
    mv mesh_deformed.su2 deformed_mesh.su2

    cd ../..
done

echo "=== Optimization loop finished at iteration ${ITER}: $(date) ==="
echo "Final CD=$DRAG CL=$LIFT (target: minimize CD at fixed CL)"

# If max iterations reached without convergence, resubmit to continue:
if [ "$ITER" -ge $((MAX_DESIGN_ITERS - 1)) ] && ! awk -v g="$GRAD_NORM" -v t="$GRAD_TOL" 'BEGIN{exit !(g < t)}'; then
    echo "Max iterations reached without full convergence - resubmitting"
    sbatch "$0"
fi