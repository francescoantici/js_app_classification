#!/bin/bash
#SBATCH --job-name=horovod_torch
#SBATCH --partition=gpu
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=24
#SBATCH --gres=gpu:v100:2
#SBATCH --time=72:00:00

cd $SLURM_SUBMIT_DIR

singularity exec --nv pytorch.sif     horovodrun -np 8 python train_hvd_torch.py     --use-adasum     --fp16-allreduce     --data-dir /imagenet     --epochs=90
