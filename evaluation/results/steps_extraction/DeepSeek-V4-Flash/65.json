            },
            "workload_class": {
                "type": "simulation",
                "primary_software": "lammps",
                "executed_file": null,
                "parameters": [
                    "-k on g 32",
                    "-sf kk",
                    "-pk kokkos gpu/aware on",
                    "-in in.benchmark_cascade",
                    "-log benchmark_32ranks.log"
                ],
                "step_description": "Run strong-scaling benchmark with srun for 32 MPI ranks."
