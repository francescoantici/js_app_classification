            },
            "workload_class": {
                "type": "simulation",
                "primary_software": "lammps",
                "executed_file": null,
                "parameters": [
                    "-k on g $TOTAL_GPUS",
                    "-sf kk",
                    "-pk kokkos gpu/aware on neigh full newton on",
                    "-in in.cascade_production",
                    "-var seed \"$RANDOM\"",
                    "-var dump_dir dumps",
                    "-log lammps_production.log"
                ],
                "step_description": "Run production LAMMPS simulation using all available GPUs."
            }
        },
        {
            "step_id": 8,
