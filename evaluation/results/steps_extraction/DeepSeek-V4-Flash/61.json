                "type": "native",
                "tool_detected": null
            },
            "workload_class": {
                "type": "simulation",
                "primary_software": "Quantum ESPRESSO",
                "executed_file": null,
                "parameters": [
                    "-npool",
                    "4",
                    "-in",
                    "scf.in",
                    ">",
                    "scf.out"
                ],
                "step_description": "Run a Quantum ESPRESSO SCF ground state calculation using pw.x with 32 MPI tasks with 4 pools, outputting to scf.out and checking for convergence."
            }
        },
        {
            "step_id": 2,
            "orchestration": {
                "type": "standalone",
                "tool_detected": null
            },
            "execution_environment": {
