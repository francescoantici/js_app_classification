                "executed_file": null,
                "parameters": [
                    "-npool",
                    "8",
                    "-in",
                    "phonon.in",
                    ">",
                    "phonon.out"
                ],
                "step_description": "Run a DFPT phonon calculation using ph.x with 128 MPI tasks in 8 pools, resuming from recover files if present, and optionally resubmitting itself if the run is incomplete."
            }
        },
        {
            "step_id": 3,
            "orchestration": {
                "type": "standalone",
                "tool_detected": null
