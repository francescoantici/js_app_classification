{
    "description": "This job script runs a WRF ensemble simulation with 32 members, each on dedicated compute nodes. For each member, it sets up the member directory, links input files, perturbs initial conditions with a Python script, modifies the namelist with random seeds, runs the WRF model, and checks for successful completion before copying output files.",
    "domain": "atmospheric science",
    "steps": [
        {
            "step_id": 1,
            "orchestration": {
                "type": "job_array",
                "tool_detected": null
            },
            "execution_environment": {
                "type": "native",
                "tool_detected": null
            },
            "workload_class": {
                "type": "utility",
                "primary_software": "bash",
                "executed_file": null,
                "parameters": [
                    "mkdir -p logs"
                ],
                "step_description": "Create the log directory for output logs."
            }
        },
        {
            "step_id": 2,
            "orchestration": {
                "type": "job_array",
                "tool_detected": null
            },
            "execution_environment": {
                "type": "native",
                "tool_detected": null
            },
            "workload_class": {
                "type": "utility",
                "primary_software": "bash",
                "executed_file": null,
                "parameters": [
                    "MEMBER=$(printf \"%03d\" \"$SLURM_ARRAY_TASK_ID\")"
                ],
                "step_description": "Set up the ensemble member directory and change into it."
            }
        },
        {
            "step_id": 3,
            "orchestration": {
                "type": "job_array",
                "tool_detected": null
            },
            "execution_environment": {
                "type": "native",
                "tool_detected": null
            },
            "workload_class": {
                "type": "utility",
                "primary_software": "bash",
                "executed_file": null,
                "parameters": [
                    "module purge",
                    "module load netcdf/4.9.2",
                    "module load hdf5/1.14.0",
                    "module load wrf/4.5.2"
                ],
                "step_description": "Load necessary modules for the WRF model environment."
            }
        },
        {
            "step_id": 4,
            "orchestration": {
                "type": "job_array",
                "tool_detected": null
            },
            "execution_environment": {
                "type": "native",
                "tool_detected": null
            },
            "workload_class": {
                "type": "utility",
                "primary_software": "bash",
                "executed_file": null,
                "parameters": [
                    "ln -sf \"${BASE_DIR}/geo_em.d01.nc\" .",
                    "ln -sf \"${BASE_DIR}/wrfinput_d01_base\" wrfinput_d01",
                    "ln -sf \"${BASE_DIR}/wrfbdy_d01_base\" wrfbdy_d01",
                    "cp \"${BASE_DIR}/namelist.input\" ."
                ],
                "step_description": "Link and copy necessary WRF input files (geogrid, initial, boundary, namelist) from the base directory."
            }
        },
        {
            "step_id": 5,
            "orchestration": {
                "type": "job_array",
                "tool_detected": null
            },
            "execution_environment": {
                "type": "native",
                "tool_detected": null
            },
            "workload_class": {
                "type": "data_analytics",
                "primary_software": "python",
                "executed_file": "/projects/myuser/wrf/case_2026072800/scripts/perturb_ic.py",
                "parameters": [
                    "--input wrfinput_d01",
                    "--seed \"$SLURM_ARRAY_TASK_ID\"",
                    "--perturbation-scale 0.5",
                    "--output wrfinput_d01"
                ],
                "step_description": "Run a Python script to perturb the WRF initial conditions for this ensemble member."
            }
        },
        {
            "step_id": 6,
            "orchestration": {
                "type": "job_array",
                "tool_detected": null
            },
            "execution_environment": {
                "type": "native",
                "tool_detected": null
            },
            "workload_class": {
                "type": "utility",
                "primary_software": "sed",
                "executed_file": null,
                "parameters": [
                    "sed -i \"s/^ iseed_skebs.*/ iseed_skebs = ${SLURM_ARRAY_TASK_ID},\" namelist.input",
                    "sed -i \"s/^ iseed_sppt.*/ iseed_sppt = $((SLURM_ARRAY_TASK_ID + 1000)),\" namelist.input"
                ],
                "step_description": "Modify the namelist.input to update stochastic seed parameters for this ensemble member."
            }
        },
        {
            "step_id": 7,
            "orchestration": {
                "type": "job_array",
                "tool_detected": null
            },
            "execution_environment": {
                "type": "native",
                "tool_detected": null
            },
            "workload_class": {
                "type": "simulation",
                "primary_software": "WRF",
                "executed_file": null,
                "parameters": [
                    "--mpi=pmix",
                    "./wrf.exe"
                ],
                "step_description": "Run the WRF model executable in parallel using MPI."
            }
        },
        {
            "step_id": 8,
            "orchestration": {
                "type": "job_array",
                "tool_detected": null
            },
            "execution_environment": {
                "type": "native",
                "tool_detected": null
            },
            "workload_class": {
                "type": "utility",
                "primary_software": "bash",
                "executed_file": null,
                "parameters": [
                    "grep -q \"SUCCESS COMPLETE WRF\" rsl.out.0000"
                ],
                "step_description": "Check the WRF output log for the success message indicating a successful run."
            }
        },
        {
            "step_id": 9,
            "orchestration": {
                "type": "job_array",
                "tool_detected": null
            },
            "execution_environment": {
                "type": "native",
                "tool_detected": null
            },
            "workload_class": {
                "type": "utility",
                "primary_software": "bash",
                "executed_file": null,
                "parameters": [
                    "mkdir -p \"${BASE_DIR}/output/mem_${MEMBER}\"",
                    "cp wrfout_d01_* \"${BASE_DIR}/output/mem_${MEMBER}/\""
                ],
                "step_description": "Copy successful WRF output files to the ensemble output directory."
            }
        },
        {
            "step_id": 10,
            "orchestration": {
                "type": "job_array",
                "tool_detected": null
            },
            "execution_environment": {
                "type": "native",
                "tool_detected": null
            },
            "workload_class": {
                "type": "utility",
                "primary_software": "bash",
                "executed_file": null,
                "parameters": [
                    "echo \"Member ${MEMBER} completed successfully\"",
                    "tail -n 30 rsl.error.0000"
                ],
                "step_description": "Print a success message or output error details if the WRF run failed."
            }
        }
    ]
}